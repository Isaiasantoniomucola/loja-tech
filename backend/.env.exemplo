PORTA=4000
DB_HOST=localhost
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=loja_tech
JWT_SEGREDO=troque-este-segredo
# Conta de administrador (usada por: npm run criar-admin)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@lojatech.com
ADMIN_SENHA=Admin@12345

# Entidade Multicaixa usada nas referências de pagamento (pedir ao seu banco/EMIS)
MULTICAIXA_ENTIDADE=00000

# (opcional) Origens permitidas para chamar a API, separadas por vírgulas. Vazio = qualquer origem (só para desenvolvimento).
# CORS_ORIGENS=https://www.minhaloja.ao
# Atrás de um proxy (Nginx, etc.): TRUST_PROXY=1
